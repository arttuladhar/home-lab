services:
  nginx-proxy-manager:
    image: "jc21/nginx-proxy-manager:{{ npm_version }}"
    container_name: Nginx-Proxy-Manager
    healthcheck:
      test: timeout 10s bash -c ':> /dev/tcp/127.0.0.1/81' || exit 1
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 90s
    volumes:
      - "{{ npm_stack_dir }}/letsencrypt:/etc/letsencrypt:rw"
      - "{{ npm_stack_dir }}/data:/data:rw"
      - "{{ npm_stack_dir }}/config.json:/app/config/production.json"
    environment:
      TZ: "{{ npm_timezone }}"
      INITIAL_ADMIN_EMAIL: "{{ npm_initial_admin_email }}"
      INITIAL_ADMIN_PASSWORD: "{{ npm_initial_admin_password }}"
    ports:
{% for p in npm_ports %}
      - "{{ p }}"
{% endfor %}
    restart: on-failure:5
